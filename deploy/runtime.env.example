# Install as /opt/notionnext/runtime.env, owned by root, mode 0600.
NOTION_PAGE_ID=5c5e408cde5f8284898f81f85ab7442a
NEXT_PUBLIC_THEME=endspace
NEXT_PUBLIC_AUTHOR=Qianchang
# Replace with the final origin after DNS is configured; rebuild for NEXT_PUBLIC_* changes.
NEXT_PUBLIC_LINK=https://qianchang.netlify.app
NEXT_PUBLIC_REVALIDATE_SECOND=60
VERCEL_ENV=production
ENABLE_CACHE=true
HOSTNAME=0.0.0.0
PORT=3000
NOTION_NEXT_NOTION_CACHE_DIR=/app/.next/cache/notion
# Generate on server: openssl rand -hex 32. Never commit the resulting value.
REVALIDATION_TOKEN=REPLACE_ON_SERVER
